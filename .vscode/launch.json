{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Client (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build (Debug)",
      "program": "${env:VINTAGE_STORY}/Vintagestory.exe",
      "cwd": "${env:VINTAGE_STORY}",
      "args": [
        "--playStyle",
        "preset-surviveandbuild",
        "--openWorld",
        "test-signals",
        "--addModPath",
        "${workspaceFolder}/bin/Debug/net10.0",
        "--addOrigin",
        "${workspaceFolder}/assets",
        "--dataPath",
        "${env:VINTAGE_STORY}Data"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Attach to Vintage Story (.NET)",
      "type": "coreclr",
      "request": "attach",
      "processName": "Vintagestory"
    }
  ]
}